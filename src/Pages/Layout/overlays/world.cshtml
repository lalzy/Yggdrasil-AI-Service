<!-- world.cshtml -->
<div id="overlay-WorldForm" class="overlay-content" style="display:none">
    <h3 id="worldFormTitle">Create World</h3>
    <form>
        <input type="text" placeholder="World name" id="worldFormName"/>
        <button class="top-btn" type="button" id="worldFormSubmit">Create</button>
    </form>
</div>


<script>
    function openWorldForm(id = null){
        const title = document.getElementById('worldFormTitle');
        const nameInput = document.getElementById('worldFormName');
        const submitButton = document.getElementById('worldFormSubmit');

        if(id){
            title.textContent = 'Edit World';
            submitButton.textContent = 'Save';
            submitButton.setAttribute('onclick', `submitWorld('${id}')`);
            fetch(`/api/world/${id}`).then(r => r.json()).then(res => {
                nameInput.value = res.data.name ?? '';
            });
        }else{
            title.textContent = 'Create World';
            submitButton.textContent = 'Create';
            submitButton.setAttribute('onclick', 'submitWorld()');
        }

        openOverlay('overlay-WorldForm');
    }


    async function submitWorld(id = null){
        const Name = document.getElementById('worldFormName').value;
        const url = id ? `/api/world/${id}` : '/api/world/create';
        const method = id ? 'PUT' : 'POST';

        const res = await fetch(url, {
            method,
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify({
                Name
                })
        });

        if(res.ok){
            closeOverlay();
            loadWorlds();
        }
    }
</script>