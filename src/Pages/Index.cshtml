@page

<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: system-ui, sans-serif; height: 100vh; display: flex; }
    
    .layout { display: flex; width: 100%; height: 100vh; }
    
    .sidebar {
        width: 240px;
        background: #f5f5f5;
        border-right: 1px solid #e0e0e0;
        display: flex;
        flex-direction: column;
    }
    .sidebar-header {
        padding: 12px;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .sidebar-header h3 { font-size: 14px; }
    .new-btn {
        background: none; border: 1px solid #ccc; border-radius: 6px;
        padding: 4px 10px; cursor: pointer; font-size: 13px;
    }
    .conv-list { flex: 1; overflow-y: auto; padding: 8px; }
    .conv-item {
        padding: 8px 10px; border-radius: 6px; cursor: pointer;
        margin-bottom: 4px; font-size: 13px;
    }
    .conv-item:hover { background: #e8e8e8; }
    .conv-item.active { background: #d0e0ff; }
    .conv-item .time { font-size: 11px; color: #999; margin-top: 2px; }
    .sidebar-footer {
        padding: 8px; border-top: 1px solid #e0e0e0;
    }
    .settings-btn {
        background: none; border: none; cursor: pointer;
        font-size: 13px; color: #666; padding: 8px 10px;
    }

    .chat-area {
        flex: 1; display: flex; flex-direction: column; background: #fff;
    }
    .messages {
        flex: 1; overflow-y: auto; padding: 20px 24px;
        display: flex; flex-direction: column; gap: 16px;
    }
    .msg { display: flex; gap: 10px; max-width: 80%; }
    .msg.assistant { }
    .msg .avatar {
        width: 28px; height: 28px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 12px; font-weight: bold; flex-shrink: 0;
    }
    .msg.user .avatar { background: #d0e0ff; color: #185fa5; }
    .msg.assistant .avatar { background: #e1f5ee; color: #0f6e56; }
    .msg .bubble {
        background: #f5f5f5; border-radius: 8px; padding: 10px 14px;
        font-size: 14px; line-height: 1.5;
    }

    .input-area {
        padding: 12px 24px 16px;
        border-top: 1px solid #e0e0e0;
        display: flex; gap: 8px; align-items: end;
    }
    .input-area textarea {
        flex: 1; resize: none; height: 44px; font-size: 14px;
        padding: 10px 14px; border: 1px solid #ccc; border-radius: 8px;
        font-family: inherit; outline: none;
    }
    .input-area textarea:focus { border-color: #378add; }
    .send-btn {
        height: 44px; padding: 0 16px; background: #378add; color: #fff;
        border: none; border-radius: 8px; font-size: 14px; font-weight: 500;
        cursor: pointer;
    }
    .send-btn:hover { background: #185fa5; }
</style>

<div class="layout">
    <div class="sidebar">
        <div class="sidebar-header">
            <h3>Conversations</h3>
            <button class="new-btn" onclick="newConversation()">+ New</button>
        </div>
        <div class="conv-list" id="convList"></div>
        <div class="sidebar-footer">
            <button class="settings-btn">Settings</button>
        </div>
    </div>

    <div class="chat-area">
        <div class="messages" id="messages"></div>
        <div class="input-area">
            <textarea id="prompt" placeholder="Type a message..." onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();send();}"></textarea>
            <button class="send-btn" onclick="send()">Send</button>
        </div>
    </div>
</div>

<script>
    let currentConvId = null;

    async function loadConversations() {
        const res = await fetch('/api/conversations');
        const ids = await res.json();
        const list = document.getElementById('convList');
        list.innerHTML = ids.map(c =>
            `<div class="conv-item ${c.conversation_ID === currentConvId ? 'active' : ''}" onclick="selectConversation('${c.conversation_ID}')">
                ${escapeHtml(c.title.substring(0, 30))}
                <div class="time"></div>
            </div>`
        ).join('');
    }

    async function selectConversation(id) {
        currentConvId = id;
        await loadConversations();
        await loadMessages();
    }

    async function loadMessages() {
        if (!currentConvId) return;
        const res = await fetch(`/api/conversations/${currentConvId}/messages`);
        const msgs = await res.json();
        const container = document.getElementById('messages');
        container.innerHTML = msgs.map(m => {
            const role = m.role === 2 ? 'user' : 'assistant';
            const label = role === 'user' ? 'U' : 'AI';
            return `<div class="msg ${role}">
                <div class="avatar">${label}</div>
                <div class="bubble">${escapeHtml(m.content)}</div>
            </div>`;
        }).join('');
        container.scrollTop = container.scrollHeight;
    }

    async function send() {
        const input = document.getElementById('prompt');
        const content = input.value.trim();
        if (!content) return;

        input.value = '';

        const body = currentConvId
            ? { conversation_ID: currentConvId, content }
            : { content };

        const res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        const log = await res.json();
        currentConvId = log.conversation_ID;

        await loadMessages();
        await loadConversations();
    }

    function newConversation() {
        currentConvId = null;
        document.getElementById('messages').innerHTML = '';
        loadConversations();
    }

    function escapeHtml(text) {
        const d = document.createElement('div');
        d.textContent = text;
        return d.innerHTML;
    }

    loadConversations();
</script>